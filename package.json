{
	"name": "@three-ws/x402-server",
	"version": "0.1.3",
	"description": "The merchant side of x402 — turn any HTTP endpoint into a paid one. Issue 402 challenges, price SKUs, verify and settle the X-PAYMENT header on Solana and Base, and take a platform fee. Advertise the two main assets — USDC and $THREE — in one challenge.",
	"type": "module",
	"main": "./src/index.js",
	"module": "./src/index.js",
	"types": "./src/index.d.ts",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"import": "./src/index.js",
			"default": "./src/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"examples",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node --test test/*.test.js"
	},
	"keywords": [
		"x402",
		"402",
		"payment-required",
		"paywall",
		"usdc",
		"three",
		"solana",
		"base",
		"eip-3009",
		"merchant",
		"middleware",
		"agent-payments",
		"three.ws",
		"ai-agents"
	],
	"author": "nirholas <support@three.ws>",
	"license": "Apache-2.0",
	"homepage": "https://nirholas.github.io/x402-server/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nirholas/x402-server.git"
	},
	"bugs": {
		"url": "https://github.com/nirholas/x402-server/issues"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {},
	"publishConfig": {
		"access": "public"
	}
}
