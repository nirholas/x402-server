{
	"name": "@three-ws/x402-server",
	"version": "0.1.1",
	"description": "The seller side of x402 — turn any HTTP endpoint into a paid one. Build 402 challenges, verify the X-PAYMENT header against a facilitator, dispatch the work, then settle on Solana and Base. USDC by default, with an optional $THREE (Solana SPL) settlement token.",
	"type": "module",
	"main": "./src/index.js",
	"module": "./src/index.js",
	"types": "./src/index.d.ts",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"import": "./src/index.js",
			"default": "./src/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "node --test test/*.test.js"
	},
	"keywords": [
		"x402",
		"402",
		"payment-required",
		"paywall",
		"usdc",
		"three",
		"solana",
		"base",
		"eip-3009",
		"merchant",
		"seller",
		"middleware",
		"agent-payments"
	],
	"author": "nirholas",
	"license": "SEE LICENSE IN LICENSE",
	"homepage": "https://github.com/nirholas/x402-server#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nirholas/x402-server.git"
	},
	"bugs": {
		"url": "https://github.com/nirholas/x402-server/issues"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {},
	"publishConfig": {
		"access": "public"
	}
}
